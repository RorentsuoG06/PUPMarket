<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to private directories and .env files
    RewriteRule ^(\.env|config/|src/|views/|database/) - [F,L,NC]

    # Forward all other requests to public/
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
