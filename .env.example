# Database (mysql for XAMPP, pgsql for Supabase)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_pupmarket

# Optional Supabase / PostgreSQL
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASS=
SUPABASE_DB_SSLMODE=require

# Resend Email API
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="IskoFinds <onboarding@resend.dev>"

# Microsoft OAuth (Optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=

# Nexconn Chat (keep the App Secret private; never add it to frontend code)
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_REGION=SG
